# Credenciales del admin para E2E (mismas que usa el seeder de la BD).
# Copiar a .env (NO committear) o exportar como variables de entorno.
# En CI se inyectan como secrets del workflow (e2e.yml).
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=

# Opcional: base URL de la app y de la API (defaults apuntan al contenedor local).
# E2E_BASE_URL=http://localhost:3000
# E2E_API_URL=http://localhost:3000/api
